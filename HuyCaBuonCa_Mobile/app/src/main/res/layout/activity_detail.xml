<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Cinema Video Player (16:9 standard web player ratio) -->
    <FrameLayout
        android:id="@+id/layoutPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="never"
            app:use_controller="false" />

        <WebView
            android:id="@+id/webViewPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Touch surface for gesture controls (bắt cử chỉ vuốt) -->
        <View
            android:id="@+id/gestureTouchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/playerLoading"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFD700"
            android:visibility="gone" />

        <!-- Gesture HUD Overlay (Volume, Brightness, Seek) -->
        <LinearLayout
            android:id="@+id/layoutGestureOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_focus_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgGestureIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_volume" />

            <TextView
                android:id="@+id/txtGestureInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="🔊 Âm lượng: 80%" />
        </LinearLayout>

        <!-- TOÀN BỘ BỘ ĐIỀU KHIỂN CHUYÊN NGHIỆP (CONTROLS OVERLAY) -->
        <FrameLayout
            android:id="@+id/layoutPlayerControlsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#44000000">

            <!-- TOP CONTROLS BAR -->
            <LinearLayout
                android:id="@+id/layoutTopControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#99000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnPlayerBack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Quay lại"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_revert" />

                <TextView
                    android:id="@+id/txtPlayerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Tên Phim • Tập 01" />

                <ImageButton
                    android:id="@+id/btnPip"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Cửa sổ nổi PiP"
                    android:padding="7dp"
                    android:src="@drawable/ic_pip" />

                <TextView
                    android:id="@+id/btnSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="1.0x"
                    android:textColor="#FFD700"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAspectRatio"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Tỷ lệ khung hình"
                    android:padding="7dp"
                    android:src="@drawable/ic_aspect_ratio" />

                <ImageButton
                    android:id="@+id/btnEpisodeSheet"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Chọn tập"
                    android:padding="7dp"
                    android:src="@drawable/ic_episodes_list" />

                <ImageButton
                    android:id="@+id/btnLock"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Khóa màn hình"
                    android:padding="7dp"
                    android:src="@drawable/ic_lock" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Cài đặt phát"
                    android:padding="7dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <!-- CENTER CONTROLS (Tua -10s | Tập Trước | PLAY / PAUSE To | Tập Sau | Tua +10s) -->
            <LinearLayout
                android:id="@+id/layoutCenterControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Tua lùi 10s -->
                <ImageButton
                    android:id="@+id/btnRewind10"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Tua lùi 10 giây"
                    android:padding="10dp"
                    android:src="@drawable/ic_seek_rewind" />

                <!-- Tập trước đó -->
                <ImageButton
                    android:id="@+id/btnPrevEpPlayer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Tập trước"
                    android:padding="9dp"
                    android:src="@drawable/ic_skip_previous" />

                <!-- NÚT PLAY / PAUSE TRUNG TÂM TO RÕ RÀNG -->
                <ImageButton
                    android:id="@+id/btnCenterPlayPause"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_center_play_btn"
                    android:contentDescription="Phát / Dừng"
                    android:padding="14dp"
                    android:src="@drawable/ic_pause" />

                <!-- Tập tiếp theo -->
                <ImageButton
                    android:id="@+id/btnNextEpPlayer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Tập sau"
                    android:padding="9dp"
                    android:src="@drawable/ic_skip_next" />

                <!-- Tua tới 10s -->
                <ImageButton
                    android:id="@+id/btnForward10"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Tua tới 10 giây"
                    android:padding="10dp"
                    android:src="@drawable/ic_seek_forward" />
            </LinearLayout>

            <!-- BOTTOM CONTROLS BAR: Thời gian + Thanh SeekBar vàng + Toàn màn hình -->
            <LinearLayout
                android:id="@+id/layoutBottomControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <!-- Thời gian hiện tại -->
                <TextView
                    android:id="@+id/txtCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Thanh SeekBar chuyên dụng cho phép kéo tua mượt mà tới giữa phim -->
                <SeekBar
                    android:id="@+id/videoSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:thumbOffset="8dp" />

                <!-- Tổng thời lượng -->
                <TextView
                    android:id="@+id/txtTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#B0B8C4"
                    android:textSize="11sp" />

                <!-- Nút Fullscreen -->
                <ImageButton
                    android:id="@+id/btnFullscreen"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="Toàn màn hình"
                    android:padding="6dp"
                    android:src="@drawable/ic_fullscreen" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bề mặt cảm ứng khi khóa (bắt chạm để nhắc nhở nút mở khóa) -->
        <View
            android:id="@+id/lockTouchSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Unlock button (Chỉ hiện khi màn hình bị khóa) -->
        <ImageButton
            android:id="@+id/btnUnlock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Mở khóa màn hình"
            android:elevation="16dp"
            android:padding="11dp"
            android:src="@drawable/ic_lock_open"
            android:visibility="gone" />

        <!-- Nút Bỏ qua Intro (+85s) chuẩn Netflix/vBook -->
        <TextView
            android:id="@+id/btnSkipIntro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="60dp"
            android:background="@drawable/bg_btn_selector"
            android:clickable="true"
            android:elevation="14dp"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="+85s Bỏ qua Intro ►"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Scrollable content below video player -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Title & Metadata -->
            <TextView
                android:id="@+id/txtDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_gold"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Tên phim mẫu ở đây" />

            <TextView
                android:id="@+id/txtDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/brand_cyan"
                android:textSize="11sp"
                tools:text="Năm: 2026 • Đang phát: Tập 12" />

            <!-- Quick Player Actions (Prev / Next episode) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrevEpisode"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="◄ Tập Trước"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNextEpisode"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Tập Tiếp Theo ►"
                    android:textColor="#0B0E14"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút chuyển nhanh danh sách kênh cùng nhóm khi xem TV -->
            <TextView
                android:id="@+id/btnSameGroupChannels"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📋 Danh Sách Kênh Cùng Nhóm"
                android:textColor="@color/brand_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Server selector tabs (Scrollable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chọn Server phát:"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutServers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Episode Selector Grid (Bắt chước web xem phim) -->
            <TextView
                android:id="@+id/txtEpisodesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Danh sách tập:"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressEpisodes"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="#222C3E" />

            <!-- Movie Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nội Dung Chi Tiết:"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Nội dung tóm tắt chi tiết của bộ phim..." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

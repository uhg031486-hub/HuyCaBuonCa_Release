<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#2A3854" android:endColor="#1C273C" android:angle="90" />
            <stroke android:width="2.5dp" android:color="@color/brand_gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="3dp" android:color="@color/brand_gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E273A" android:endColor="#141B28" android:angle="90" />
            <stroke android:width="1dp" android:color="#2B3A54" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFA000" android:endColor="#FF6F00" android:angle="45" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFD700" android:endColor="#FF9100" android:angle="45" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFF000" android:endColor="#FF9900" android:angle="45" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFD700" android:endColor="#FF9100" android:angle="45" />
            <stroke android:width="1.5dp" android:color="#FFC107" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

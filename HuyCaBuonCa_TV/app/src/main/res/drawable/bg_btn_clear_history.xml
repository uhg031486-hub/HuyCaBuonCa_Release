<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi bấm vào (Pressed) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFE082" android:centerColor="#FFD700" android:endColor="#FF9100" android:angle="90" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- Khi focus (D-Pad Remote TV) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFF9C4" android:centerColor="#FFD700" android:endColor="#FF8F00" android:angle="90" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- Trạng thái mặc định: Nền vàng rực rỡ tương phản cao -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFE082" android:centerColor="#FFD700" android:endColor="#FFA000" android:angle="90" />
            <stroke android:width="1dp" android:color="#FFA000" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>

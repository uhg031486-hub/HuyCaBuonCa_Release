<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFA000"
                android:centerColor="#FFD700"
                android:endColor="#FFE082"
                android:angle="90" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
            <corners android:radius="5dp" />
            <padding android:left="7dp" android:right="7dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF8F00"
                android:centerColor="#FFD700"
                android:endColor="#FFF9C4"
                android:angle="45" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="5dp" />
            <padding android:left="7dp" android:right="7dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D32F2F"
                android:centerColor="#FF6F00"
                android:endColor="#FFD700"
                android:angle="45" />
            <stroke android:width="1.2dp" android:color="#FFE082" />
            <corners android:radius="5dp" />
            <padding android:left="7dp" android:right="7dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
</selector>

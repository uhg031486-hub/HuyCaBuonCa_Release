<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Native Media3 ExoPlayer for HLS .m3u8 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- Fallback WebView for embed player streams -->
    <WebView
        android:id="@+id/webViewPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/playerProgress"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Top Watermark & Copyright Bar (Stylish Branding) -->
    <LinearLayout
        android:id="@+id/layoutWatermark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txtPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Tên Phim - Tập 01 (Vietsub)" />
    </LinearLayout>

    <!-- On-screen TV Channel Zapping Banner (Hiện khi đổi kênh TV) -->
    <LinearLayout
        android:id="@+id/layoutChannelBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="28dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_btn_secondary"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtChannelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KÊNH 01"
            android:textColor="@color/brand_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="VTV6 Thể Thao HD"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtChannelGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhóm: Bóng Đá &amp; Thể Thao"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- TV Remote Help Bar at Bottom (Auto fades out) -->
    <TextView
        android:id="@+id/txtRemoteTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#B3000000"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="Điều khiển Remote: [ ▲ / ▼ ] Đổi Kênh Cùng Nhóm  •  [ ◄ ] Danh Sách Kênh  •  [ ► ] Tua 10s  •  [ OK ] Phát/Dừng"
        android:textColor="@color/brand_gold"
        android:textSize="11sp" />

    <!-- Side Quick Channel Strip (Danh sách kênh cùng nhóm khi bấm Phím Trái hoặc Menu) -->
    <LinearLayout
        android:id="@+id/layoutSideChannelList"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F00D1117"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtSideGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANH SÁCH KÊNH CÙNG NHÓM"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSideGroupSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Bấm OK/Enter để chuyển kênh tức thì"
            android:textColor="#8B949E"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSideChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>

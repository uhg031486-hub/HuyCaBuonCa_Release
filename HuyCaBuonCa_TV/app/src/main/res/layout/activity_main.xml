<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="4dp"
    android:paddingEnd="14dp"
    android:paddingBottom="4dp">

    <!-- Top Header Bar with stylish Branding & Sources -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtBrandBadge"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:gravity="center"
                android:background="@drawable/bg_brand_badge"
                android:text="@string/brand_badge"
                android:textColor="#000000"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/brand_slogan"
                android:textColor="@color/brand_gold"
                android:textSize="8sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Source Selector Tabs (D-Pad navigation) -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSourceKKPhim"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_btn_selector"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@animator/elevation_3d"
                    android:focusable="true"
                    android:text="🎬 PHIM (ĐA NGUỒN)"
                    android:textColor="@color/selector_btn_text"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSourceAnimeHay"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_btn_selector"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@animator/elevation_3d"
                    android:focusable="true"
                    android:text="⛩️ ANIME"
                    android:textColor="@color/selector_btn_text"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSourceXemTiVi"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_btn_selector"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@animator/elevation_3d"
                    android:focusable="true"
                    android:text="📺 XEM TIVI"
                    android:textColor="@color/selector_btn_text"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSourceFreeReels"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@drawable/bg_btn_selector"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@animator/elevation_3d"
                    android:focusable="true"
                    android:text="🎬 PHIM NGẮN (FREEREELS)"
                    android:textColor="@color/selector_btn_text"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Search button -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/bg_btn_selector"
            app:backgroundTint="@null"
            android:stateListAnimator="@animator/elevation_3d"
            android:focusable="true"
            android:text="🔍 TÌM KIẾM"
            android:textColor="@color/brand_cyan"
            android:textSize="10.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ANIME / MOVIE SUB-SOURCES BAR (KKPHIM, NGUONC, THUYET MINH, BOM TAN...) -->
    <HorizontalScrollView
        android:id="@+id/scrollAnimeSubSources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutAnimeSubSources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- DYNAMIC Category / Genre Filter Bar (Thay đổi tự động theo từng nguồn) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutDynamicFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Hàng Đang Xem Gần Đây (Lịch Sử Tiếp Tục Xem) -->
    <LinearLayout
        android:id="@+id/layoutContinueWatching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:layout_marginBottom="2dp"
        android:background="#0D131F"
        android:orientation="vertical"
        android:padding="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🕒 TIẾP TỤC XEM (LỊCH SỬ XEM DỞ)"
                android:textColor="@color/brand_gold"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="@drawable/bg_btn_clear_history"
                app:backgroundTint="@null"
                android:stateListAnimator="@animator/elevation_3d"
                android:focusable="true"
                android:text="🗑️ XÓA LỊCH SỬ"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="1dp" />
    </LinearLayout>

    <!-- Main Content Area: Movie Grid (7 columns nhỏ gọn để hiển thị 3-4 hàng) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMovies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="6dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Không tìm thấy phim nào" />

        <!-- Loading More Indicator for TV -->
        <ProgressBar
            android:id="@+id/progressLoadMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Footer Bar: Trademark & Copyright -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="1dp">

        <TextView
            android:id="@+id/txtCopyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_copyright"
            android:textColor="@color/brand_gold"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
